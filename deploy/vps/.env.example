DOMAIN=ai.arbuz.lol
IMAGE=ghcr.io/pmixay/mologate:main-slim
APP_UPSTREAM=mologate-production
# Production onboarding allows signup with admin approval; staging stays closed.
# Existing database settings must also be changed in Admin Settings > General.
ENABLE_SIGNUP=False
# Generate distinct values with: openssl rand -hex 32
WEBUI_SECRET_KEY=
POSTGRES_PASSWORD=
# Fresh installs use PostgreSQL 17 with pgvector. Existing installations must
# keep their current image until a logical dump/restore into a new volume.
POSTGRES_IMAGE=pgvector/pgvector:pg17-bookworm
# Chat works without an embeddings key. Documents need a configured API.
RAG_OPENAI_API_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
# Staging only: COMPOSE_FILE=compose.yaml:compose.staging.yaml
