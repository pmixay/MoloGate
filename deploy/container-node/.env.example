# Mologate container node on its own machine (docs/container-nodes.md).
# The node's address, with an A record pointing at this machine.
NODE_DOMAIN=node-2.example.com
# Space-separated addresses of the Mologate site that may call this node.
SITE_IPS=5.83.140.221
# A short unique name, and the key Mologate uses (openssl rand -hex 32). Add the node in
# Admin Settings > Integrations > Chat containers with https://NODE_DOMAIN and this key.
NODE_ID=node-2
NODE_NAME=Node 2
NODE_API_KEY=
# NODE_MAX_ACTIVE=
# CONTAINER_MEMORY=1g
# CONTAINER_CPUS=1
